# 복사해서 .env 로 쓴다. Next.js 와 Prisma CLI(prisma7.config.ts) 둘 다 이 파일을 읽는다

# SQLite 파일 경로. 앱 폴더 기준이라 CLI 와 앱이 같은 dev.db 를 쓴다
DATABASE_URL="file:./dev.db"

# 빌릴 GPU 종류와 개수. 없거나 비어 있으면 H100 1대 (src/lib/gpu/config.ts)
GPU_TYPE="H100"
GPU_COUNT=1

# GPU 서버 접속 정보. gpu/ 워커를 배포한 뒤 채운다
# GPU_API_URL: 배포한 추론 엔드포인트 주소
# GPU_API_TOKEN: 요청 헤더 Authorization: Bearer 로 보낼 값. Modal 은 Proxy Auth Token 을 "토큰ID.토큰Secret" 으로 이어 붙인다
GPU_API_URL=
GPU_API_TOKEN=

# Modal 계정. modal CLI 와 SDK 가 이 이름을 그대로 읽는다. 셸에 불러오면 ~/.modal.toml 보다 우선한다
# MODAL_PROFILE: ~/.modal.toml 의 프로필 이름 (modal profile list 로 확인)
# MODAL_TOKEN_ID, MODAL_TOKEN_SECRET: ak-, as- 로 시작하는 계정 토큰. 비운 채로 셸에 불러오면 인증이 깨지니 채우거나 줄을 지운다
MODAL_PROFILE=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Hugging Face 토큰 (huggingface.co/settings/tokens 에서 Read, 또는 Fine-grained 의 Read-Only)
# FLUX 3 Klein, Fibo 2.0 Edit Turbo 는 gated 라 이 토큰의 계정으로 두 모델 페이지 약관에 먼저 동의해야 받을 수 있다
HF_TOKEN=